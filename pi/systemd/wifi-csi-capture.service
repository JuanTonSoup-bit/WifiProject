[Unit]
Description=WiFi CSI Capture and UDP Streaming
After=network.target
Wants=network.target

[Service]
Type=simple
User=wifi-csi
Group=wifi-csi

ExecStart=/usr/bin/python3 /usr/local/lib/wifi-csi-streamer.py --config /etc/wifi-csi/config.yaml

Restart=always
RestartSec=3
StartLimitIntervalSec=60
StartLimitBurst=5

WatchdogSec=30
NotifyAccess=none

StandardOutput=journal
StandardError=journal
SyslogIdentifier=wifi-csi-capture

EnvironmentFile=-/etc/wifi-csi/environment

[Install]
WantedBy=multi-user.target
